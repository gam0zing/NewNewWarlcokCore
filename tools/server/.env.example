# 访问令牌：所有 /api 接口（除 /api/health）都需要它，请改成足够长的随机字符串。
# 生成方式示例：node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
EDITOR_TOKEN=change-me-to-a-long-random-token

# 监听地址：默认只监听本机，公网访问请用内网穿透（ngrok / frp）转发到 127.0.0.1:8787
HOST=127.0.0.1
PORT=8787

# 单次上传请求体上限（字节），默认 5MB
# MAX_UPLOAD_BYTES=5242880

# 仓库目录与审计日志（默认在 tools/tree_store 与 tools/server/audit.log）
# TREE_STORE_DIR=
# AUDIT_LOG=
